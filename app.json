{
  "expo": {
    "name": "Hangy",
    "slug": "hangy",
    "scheme": "hangy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.pucrs.ages.hangy"
    },
    "android": {
      "package": "br.pucrs.ages.hangy"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Hangy usa suas fotos para definir a capa do evento."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
