{
  "expo": {
    "name": "Hangy",
    "slug": "hangy",
    "scheme": "hangy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.pucrs.ages.hangy"
    },
    "android": {
      "package": "br.pucrs.ages.hangy"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Hangy usa suas fotos para definir a capa do evento.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Hangy usa sua localização para mostrar eventos perto de você no mapa e para preencher o endereço do seu comércio no cadastro."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#653B6B"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#653B6B"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Preserve reflectively constructed WorkManager/Room classes with SDK 58 R8.\n# https://github.com/expo/expo/issues/52173\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f278d959-6c74-40aa-8ae5-c6fb5113fecd"
      }
    },
    "owner": "gbn0s-team"
  }
}
