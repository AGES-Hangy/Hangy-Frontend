# Copie para .env.local. Nunca coloque senhas ou tokens em EXPO_PUBLIC_*:
# esses valores ficam visíveis dentro do aplicativo compilado.
# No celular, troque localhost pelo IP do computador ou por um backend HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_USE_API_MOCKS=false
# Apenas APK de teste com backend HTTP. Produção continua exigindo HTTPS.
ANDROID_ALLOW_HTTP_API=false

# Serviços públicos opcionais (valores padrão abaixo).
EXPO_PUBLIC_IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
EXPO_PUBLIC_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Override opcional: informe ambos ou deixe ambos vazios para usar app.json.
# Para EAS CLI, exporte no shell: o CLI não carrega .env.local para resolver config.
EAS_PROJECT_OWNER=
EAS_PROJECT_ID=

# Chave nativa do Maps SDK for Android, restrita ao pacote e SHA-1 do APK.
# Configure também no ambiente EAS; não é um segredo protegido dentro do APK.
GOOGLE_MAPS_ANDROID_API_KEY=
